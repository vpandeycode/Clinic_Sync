# clinic_sync Environment Configuration Example
# Copy to .env and replace secrets with secure random values for local deployment.

# Central PostgreSQL Configuration
POSTGRES_DB=clinic_central
POSTGRES_USER=clinic_admin
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password

# Edge Node Encryption Keys (AES-256 for H2 storage at rest)
EDGE_A_DB_PASSWORD=change_this_to_a_secure_edge_a_key
EDGE_B_DB_PASSWORD=change_this_to_a_secure_edge_b_key

# Central Server Port
CENTRAL_PORT=8080

# Edge Node Ports
EDGE_A_PORT=8081
EDGE_B_PORT=8082
